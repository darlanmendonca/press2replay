# Somente DEV. O codigo vem por bind mount (ver docker-compose.yml) e o
# `tsx watch` recarrega a cada mudanca; aqui so entram ffmpeg e as deps.
FROM node:25-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# `npm install` no start: o node_modules fica num volume nomeado, que nao
# acompanha mudancas de package.json sozinho.
CMD ["sh", "-c", "npm install && npm run dev"]
