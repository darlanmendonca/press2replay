# Porta da API HTTP do edge server
PORT=3000

# Modo de ingestão do stream:
#   rtmp -> sobe um servidor RTMP local (node-media-server) para o celular
#           (ou qualquer encoder) dar push do stream. Usado na fase da POC.
#   external -> nao sobe nada local, so consome uma URL ja existente
#           (ex: RTSP de uma camera IP real).
INGEST_MODE=rtmp

# Porta do servidor RTMP local (so usada quando INGEST_MODE=rtmp)
RTMP_PORT=1935

# CAMERAS: um edge atende varias cameras, uma ou mais por quadra (courtId = id da
# quadra no admin; cameraId = a camera/angulo dentro da quadra). Duas formas:
#
#  1) VARIAS cameras: arquivo cameras.json (CAMERAS_FILE, default ./cameras.json;
#     modelo em cameras.example.json). Cada entrada: courtId, cameraId, sport e
#     inputUrl. O cameraId e opcional so em quadra de uma camera (vira "main"); com
#     mais de uma todas precisam dele, e o sport e igual dentro da quadra. No modo
#     rtmp o inputUrl e opcional: sem cameraId a chave do stream e o courtId
#     (live/{courtId}), com cameraId e {courtId}.{cameraId}; no modo external e
#     obrigatorio (RTSP). O arquivo fica so no edge (tem a senha das cameras; esta no
#     .gitignore). Quando existe, ele manda e COURT_ID/SPORT/INPUT_URL abaixo sao
#     ignorados. Um aperto do botao da quadra dispara todas as cameras dela.
#  2) UMA camera, sem arquivo (como sempre foi): COURT_ID, SPORT e INPUT_URL abaixo.
#
# CAMERAS_FILE=./cameras.json

# (modo de uma camera) URL que o ffmpeg vai consumir para gerar os chunks.
#   - Fase POC (celular via RTMP local): rtmp://127.0.0.1:1935/live/stream
#   - Fase com camera real (RTSP):       rtsp://usuario:senha@IP_DA_CAMERA:554/stream1
INPUT_URL=rtmp://127.0.0.1:1935/live/stream

# Duracao "alvo" de cada chunk, em segundos. So vira realidade se a fonte
# (camera/app) tiver um I-frame interval igual ou menor que este valor,
# porque o corte so acontece em keyframes - ver README.
CHUNK_DURATION_SECONDS=1

# Quantos segundos de chunks manter em disco POR CAMERA (janela de retencao). O ffmpeg
# ja apaga sozinho cada chunk assim que ele sai dessa janela (a cada segundo,
# nao so quando o processo reinicia) - so precisa de folga sobre o corte de
# replay (90s no padel), nao precisa ser um valor grande. Nao afeta bytes escritos por
# segundo, so quanto fica acumulado - ver README (desgaste de SD/SSD).
CHUNK_WINDOW_SECONDS=120

# Janela do /replay em torno do instante do clique: X segundos de "antes"
# + Y segundos de "depois". Com SPORT definido, o TOTAL vem do esporte
# (60s por padrao, padel 90s): o pos-roll e o valor abaixo e
# o resto e pre-roll (ex.: futsal = 55 antes + 5 depois). O pre-roll abaixo so
# vale SEM esporte (total = pre + post). Selecionado pela duracao real dos
# chunks na playlist, nao pela quantidade de arquivos, e a duracao final do
# .mp4 e travada exatamente nesse total (-t no ffmpeg).
# REPLAY_PRE_ROLL_SECONDS=30
REPLAY_POST_ROLL_SECONDS=5

# Se o ultimo chunk da playlist for mais antigo que isto (em segundos, em
# relacao ao instante do clique), o /replay e recusado (503) em vez de
# devolver video velho.
STALE_AFTER_SECONDS=5

# Quanto tempo extra (ms), alem do REPLAY_POST_ROLL_SECONDS, o /replay
# espera os chunks do pos-roll serem gravados antes de desistir e responder
# com o que tiver disponivel. O pos-roll ainda nem aconteceu no instante do
# clique, entao o /replay so responde depois de pelo menos
# REPLAY_POST_ROLL_SECONDS terem se passado de verdade.
POST_ROLL_WAIT_MARGIN_MS=5000

# Se nenhum chunk novo aparecer nesse intervalo (ms), o segmenter mata e
# reinicia o ffmpeg (cobre o caso de uma leitura RTSP travada).
STALL_TIMEOUT_MS=8000

# Pastas base dos chunks e dos replays finais (relativas ao projeto). Cada camera usa
# uma subpasta propria: chunks/{courtId}/{cameraId} e output/{courtId}/{cameraId}.
CHUNKS_DIR=./chunks
OUTPUT_DIR=./output

# Upload pro web-server (cloud). Sem WEB_SERVER_URL, EDGE_API_KEY e VENUE_ID (ou sem
# courtId/esporte numa camera), o replay dessa camera fica so local.
#   WEB_SERVER_URL - ex.: https://press2replay.vercel.app
#                    dev, edge rodando no host (npm run dev): http://localhost:3001
#                    dev, edge dentro do docker compose:      http://web-server:3000
#                    (dentro do compose, localhost e o proprio container do edge)
#   EDGE_API_KEY   - chave do LOCAL, gerada no admin (/admin/places/{id} > Chave do
#                    edge). Um edge so por local, que sobe replays de qualquer quadra dele.
#   VENUE_ID       - id do local no admin (letras, numeros, - e _)
#   COURT_ID       - (modo de uma camera) id da quadra dentro do local, como cadastrada
#                    no admin. O QR do botao aponta para
#                    {WEB_SERVER_URL}/replays/{VENUE_ID}/{COURT_ID} e, impresso, nao deve mudar.
#   SPORT          - (modo de uma camera; no cameras.json e o "sport" de cada camera)
#                    esporte da quadra, define a duracao do replay:
#                    futsal|futebol|basket = 60s, padel = 90s (outro valor nao sobe)
# Upload confirmado apaga o .mp4 e o .jpg locais na hora.
WEB_SERVER_URL=
EDGE_API_KEY=
VENUE_ID=
COURT_ID=
SPORT=

# Quantos replays com upload falho (ou sem o upload configurado)
# ficam guardados POR CAMERA (output/{courtId}/{cameraId}) pra retry manual, antes dos mais antigos
# comecarem a ser descartados.
OUTPUT_RETENTION_COUNT=20
