{
  "name": "replay-edge-server",
  "version": "0.1.0",
  "description": "Edge server (Raspberry Pi) - ingests camera stream, keeps a rolling window of chunks, cuts and uploads replays",
  "private": true,
  "engines": {
    "node": ">=25"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-media-server": "^2.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
