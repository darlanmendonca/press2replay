# Somente DEV (em prod o web-server sobe na Vercel). O codigo vem por bind
# mount (ver docker-compose.yml) e o `next dev` faz o hot reload.
FROM node:24-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# `npm install` e as migrations no start: o node_modules fica num volume
# nomeado, que nao acompanha mudancas de package.json sozinho.
CMD ["sh", "-c", "npm install && npm run db:migrate && npm run dev -- --hostname 0.0.0.0"]
